+# Client / repeater uplink (mode sta) on the driver's universal-repeater interface
+# <radio>-vxd. The root AP (<radio>) must already be configured; the driver moves the
+# radio to the upstream AP's channel by itself. Only WPA/WPA2-PSK and open networks.
+rtl_setup_sta() {
+	local name="$1"
+	local ifname ssid key bssid macaddr wpa auth_type wpa_cipher
+	local psk_enable=0 encmode=0 cipher_mask=0 ieee8021x=0 authtype=2
+
+	ifname="${dev_ifname}-vxd"
+
+	json_select config
+	json_get_vars ssid key bssid macaddr
+	wireless_vif_parse_encryption
+	json_select ..
+
+	[ -d "/proc/$ifname" ] || { wireless_setup_vif_failed NO_SUCH_INTERFACE; return 1; }
+	[ -n "$ssid" ] || { wireless_setup_vif_failed MISSING_SSID; return 1; }
+
+	case "$wpa_cipher" in
+		*CCMP*TKIP*|*TKIP*CCMP*) cipher_mask=10; encmode=4 ;;
+		*CCMP*)                  cipher_mask=8;  encmode=4 ;;
+		*TKIP*)                  cipher_mask=2;  encmode=2 ;;
+	esac
+	case "$auth_type" in
+		psk)
+			psk_enable="$wpa"; ieee8021x=0
+			[ ${#key} -ge 8 ] || { wireless_setup_vif_failed INVALID_WPA_PSK; return 1; }
+		;;
+		none) psk_enable=0; encmode=0; cipher_mask=0 ;;
+		*) wireless_setup_vif_failed UNSUPPORTED_ENCRYPTION; return 1 ;;
+	esac
+
+	ifconfig "$ifname" down 2>/dev/null
+	[ -n "$macaddr" ] && ip link set dev "$ifname" address "$macaddr"
+
+	rtl_apply_mib "$ifname" \
+		"opmode=8" \
+		"ssid=$ssid" \
+		"authtype=$authtype" \
+		"psk_enable=$psk_enable" \
+		"encmode=$encmode" \
+		"802_1x=$ieee8021x" \
+		"wpa_cipher=$([ "$psk_enable" = 1 ] || [ "$psk_enable" = 3 ] && echo $cipher_mask || echo 0)" \
+		"wpa2_cipher=$([ "$psk_enable" -ge 2 ] 2>/dev/null && echo $cipher_mask || echo 0)" || {
+		wireless_setup_vif_failed MIB_WRITE_FAILED; return 1; }
+	if [ "$psk_enable" != 0 ]; then
+		rtl_apply_mib "$ifname" "passphrase=$key" || { wireless_setup_vif_failed KEY_WRITE_FAILED; return 1; }
+	fi
+
+	ifconfig "$ifname" up || { wireless_setup_vif_failed IFUP_FAILED; return 1; }
+	wireless_add_vif "$name" "$ifname"
+}
