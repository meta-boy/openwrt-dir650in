diff -ruN a/scripts/dir650in-full-image.py b/scripts/dir650in-full-image.py
--- a/scripts/dir650in-full-image.py
+++ b/scripts/dir650in-full-image.py
@@ -0,0 +1,67 @@
+#!/usr/bin/env python3
+"""Build ONE flashable image for the D-Link DIR-650IN, laid out exactly like stock:
+
+    flash 0x030000  kernel  (cvimg 'cr6c', start 0x80a00000)  padded 0xFF to 0x210000
+    flash 0x210000  rootfs  (squashfs + RTL819x bootloader checksum)
+                    rootfs_data (jffs2) is created by the kernel after the squashfs,
+                    on the next 64 KiB erase block.
+
+The file is written to flash offset 0x30000 (bootloader: FLW 30000 <ram> <len>).
+Checks, all verified against the stock image of this exact bootloader:
+  - kernel: 'cr6c', start 0x80a00000, burn 0x30000, payload word-sum 0, fits 0x1e0000
+  - rootfs: field@8 + 642 == checked length, word-sum 0, ends before 0x400000
+  - the 2-byte checksum must not fall into the first block of rootfs_data
+Usage: dir650in-full-image.py <kernel.bin> <rootfs.squashfs> <out>"""
+import struct, subprocess, sys, os
+
+KERNEL_OFS, ROOTFS_OFS, FLASH_END, ERASE = 0x30000, 0x210000, 0x400000, 0x10000
+KERNEL_MAX = ROOTFS_OFS - KERNEL_OFS
+MIN_DATA = 3 * ERASE        # jffs2 needs a few erase blocks to be useful
+
+def s16(b):
+    t = 0
+    for i in range(0, len(b) - 1, 2):
+        t = (t + ((b[i] << 8) | b[i + 1])) & 0xFFFF
+    if len(b) % 2:
+        t = (t + (b[-1] << 8)) & 0xFFFF
+    return t
+
+def main():
+    if len(sys.argv) != 4:
+        sys.exit(__doc__)
+    kern = open(sys.argv[1], "rb").read()
+    sig, start, burn, ln = kern[:4], *struct.unpack(">III", kern[4:16])
+    if sig != b"cr6c" or start != 0x80A00000 or burn != KERNEL_OFS:
+        sys.exit(f"kernel header wrong: {sig} 0x{start:X} 0x{burn:X}")
+    if 16 + ln > len(kern) or s16(kern[16:16 + ln]) != 0:
+        sys.exit("kernel payload checksum is not zero")
+    if len(kern) > KERNEL_MAX:
+        sys.exit(f"kernel {len(kern)} bytes > partition {KERNEL_MAX} (over by {len(kern) - KERNEL_MAX})")
+
+    tmp = sys.argv[3] + ".rootfs"
+    open(tmp, "wb").write(open(sys.argv[2], "rb").read())
+    chk = os.path.join(os.path.dirname(os.path.abspath(__file__)), "rtl819x-rootfs-chksum.py")
+    subprocess.run([sys.executable, chk, tmp], check=True)
+    root = open(tmp, "rb").read(); os.unlink(tmp)
+    field = struct.unpack(">I", root[8:12])[0]
+    checked = field + 642
+    if root[:4] != b"hsqs" or checked != len(root) or s16(root) != 0:
+        sys.exit("rootfs checksum layout wrong")
+    used = struct.unpack("<Q", root[40:48])[0]
+    data_start = ROOTFS_OFS + ((used + ERASE - 1) // ERASE) * ERASE   # where mtdsplit puts rootfs_data
+    if ROOTFS_OFS + checked > data_start:
+        sys.exit(f"bootloader checksum would sit in rootfs_data (0x{ROOTFS_OFS + checked:X} > 0x{data_start:X})")
+    if FLASH_END - data_start < MIN_DATA:
+        sys.exit(f"only {FLASH_END - data_start} bytes left for settings (need {MIN_DATA})")
+
+    img = kern + b"\xff" * (KERNEL_MAX - len(kern)) + root
+    # OpenWrt jffs2 "format me" marker at the start of rootfs_data, so leftover
+    # stock data there is wiped on first boot instead of forcing a RAM overlay
+    img += b"\xff" * (data_start - KERNEL_OFS - len(img)) + b"\xde\xad\xc0\xde"
+    open(sys.argv[3], "wb").write(img)
+    print(f"full image {len(img)} bytes -> flash 0x{KERNEL_OFS:X}-0x{KERNEL_OFS + len(img):X}; "
+          f"kernel {len(kern)} (free {KERNEL_MAX - len(kern)}), rootfs {len(root)}, "
+          f"settings 0x{data_start:X}-0x{FLASH_END:X} ({(FLASH_END - data_start) // 1024} KiB)")
+
+if __name__ == "__main__":
+    main()
diff -ruN a/files/etc/uci-defaults/90-dir650in b/files/etc/uci-defaults/90-dir650in
--- a/files/etc/uci-defaults/90-dir650in
+++ b/files/etc/uci-defaults/90-dir650in
@@ -0,0 +1,53 @@
+#!/bin/sh
+# First-boot defaults for the D-Link DIR-650IN repeater build.
+# Setup mode: own AP "Extender-Setup" + LAN 192.168.1.1 with DHCP; uplink (repeater client)
+# exists but stays disabled until it is configured in the web UI (/cgi-bin/api setuplink).
+
+[ "$(cat /tmp/sysinfo/board_name 2>/dev/null)" = "dlink,dir-650in" ] || exit 0
+
+# The target's wifi detect (lib/wifi/rtl8192cd.sh) may already have written the RX23302
+# defaults (default_radio0, SSID RX23302, country RU). On first boot ours always win.
+if ! uci -q get wireless.ap0 >/dev/null; then
+	touch /etc/config/wireless
+	for s in $(uci -q show wireless | sed -n 's/^wireless\.\([^.=]*\)=wifi-iface$/\1/p'); do
+		uci -q delete "wireless.$s"
+	done
+	uci -q delete wireless.radio0
+	uci batch <<-EOF
+		set wireless.radio0=wifi-device
+		set wireless.radio0.type=rtl8192cd
+		set wireless.radio0.ifname=wlan0
+		set wireless.radio0.band=2g
+		set wireless.radio0.channel=1
+		set wireless.radio0.htmode=HT20
+		set wireless.radio0.country=IN
+		set wireless.ap0=wifi-iface
+		set wireless.ap0.device=radio0
+		set wireless.ap0.network=lan
+		set wireless.ap0.mode=ap
+		set wireless.ap0.ssid=Extender-Setup
+		set wireless.ap0.encryption=psk2
+		set wireless.ap0.key=extender-setup
+		set wireless.uplink=wifi-iface
+		set wireless.uplink.device=radio0
+		set wireless.uplink.network=lan
+		set wireless.uplink.mode=sta
+		set wireless.uplink.encryption=psk2
+		set wireless.uplink.disabled=1
+	EOF
+	uci commit wireless
+fi
+
+# web UI on the LAN only, plain HTTP (no TLS stack in this 4 MB image)
+uci -q batch <<-EOF
+	delete uhttpd.main.listen_https
+	set uhttpd.main.index_page=index.html
+	set uhttpd.main.cgi_prefix=/cgi-bin
+	set uhttpd.main.redirect_https=0
+EOF
+uci commit uhttpd
+
+uci set system.@system[0].hostname=extender
+uci commit system
+
+exit 0
diff -ruN a/files/www/cgi-bin/api b/files/www/cgi-bin/api
--- a/files/www/cgi-bin/api
+++ b/files/www/cgi-bin/api
@@ -0,0 +1,148 @@
+#!/bin/sh
+# DIR-650IN repeater UI backend (uhttpd CGI). GET ?a=status|scan ; POST a=<action>&...
+# Every reply is JSON. State-changing actions need POST with Content-Type application/x-dir650in-form.
+
+js() { # JSON string literal
+	printf '"%s"' "$(printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' | tr -d '\000-\037')"
+}
+out() { printf 'Content-Type: application/json\r\nCache-Control: no-store\r\n\r\n%s\n' "$1"; exit 0; }
+fail() { out "{\"ok\":false,\"error\":$(js "$1")}"; }
+urldec() { local v; v=$(printf '%s' "$1" | sed -e 's/+/ /g' -e 's/%\([0-9A-Fa-f][0-9A-Fa-f]\)/\\x\1/g'); printf '%b' "$v"; }
+param() { # param NAME from $BODY or $QUERY_STRING
+	local kv
+	printf '%s&%s\n' "$BODY" "$QUERY_STRING" | tr '&' '\n' | while IFS= read -r kv; do
+		[ "${kv%%=*}" = "$1" ] && { urldec "${kv#*=}"; break; }
+	done
+}
+
+BODY=""
+if [ "$REQUEST_METHOD" = POST ]; then
+	[ "${CONTENT_LENGTH:-0}" -le 4096 ] || fail "request too large"
+	BODY=$(dd bs=1 count="${CONTENT_LENGTH:-0}" 2>/dev/null)
+	# CSRF guard: a non-standard content type cannot be sent cross-origin without a CORS
+	# preflight, which uhttpd never answers (uhttpd does not pass custom headers to CGI).
+	case "$CONTENT_TYPE" in application/x-dir650in*) ;; *) fail "bad request type" ;; esac
+fi
+A=$(param a)
+
+# true when root has a real password hash in /etc/shadow
+has_pw() { awk -F: '$1=="root"{f=1; exit ($2==""||$2=="*"||$2=="!"||$2=="x")} END{if(!f) exit 1}' /etc/shadow; }
+# before an admin password exists only status and setpw are allowed
+if ! has_pw; then
+	case "$A" in status|setpw) ;; *) fail "set the admin password first" ;; esac
+fi
+
+mode() { [ "$(uci -q get wireless.uplink.disabled)" = 0 ] && echo repeater || echo setup; }
+
+apply_bg() { ( sleep 1; wifi reload; /etc/init.d/network reload; /etc/init.d/dnsmasq restart ) >/dev/null 2>&1 & }
+
+case "$A" in
+status)
+	up=$(cut -d. -f1 /proc/uptime)
+	mt=$(awk '/MemTotal/{print $2}' /proc/meminfo); ma=$(awk '/MemAvailable/{print $2}' /proc/meminfo)
+	ch=$(awk '/dot11channel/{print $2; exit}' /proc/wlan0/mib_rf 2>/dev/null)
+	ips=$(ip -4 -o addr show br-lan 2>/dev/null | awk '{printf "%s%s", s, $4; s=","}')
+	# uplink: first station entry on the repeater interface = the upstream AP
+	ul_mac=""; ul_rssi=""; ul_state=""
+	if [ -r /proc/wlan0-vxd/sta_info ]; then
+		eval "$(awk '/hwaddr:/{m=$2} /state:/{s=$2} /rssi:/{r=$2; if(m!=""){printf "ul_mac=%s ul_state=%s ul_rssi=%s\n",m,s,r; exit}}' /proc/wlan0-vxd/sta_info)"
+	fi
+	clients=$(awk '/hwaddr:/{m=$2} /rssi:/{if(m!=""){printf "%s{\"mac\":\"%s\",\"rssi\":%s}", s, m, $2; s=","; m=""}}' /proc/wlan0/sta_info 2>/dev/null)
+	out "{\"ok\":true,\"pw\":$(has_pw && echo true || echo false),\"mode\":\"$(mode)\",\"uptime\":${up:-0},\"mem_total\":${mt:-0},\"mem_avail\":${ma:-0},\"channel\":${ch:-0},\"ips\":$(js "$ips"),\"ap_ssid\":$(js "$(uci -q get wireless.ap0.ssid)"),\"up_ssid\":$(js "$(uci -q get wireless.uplink.ssid)"),\"up_mac\":$(js "$ul_mac"),\"up_rssi\":${ul_rssi:-0},\"up_connected\":$([ -n "$ul_mac" ] && echo true || echo false),\"clients\":[${clients}]}"
+	;;
+scan)
+	echo 1 > /proc/wlan0/SS_Result 2>/dev/null
+	i=0
+	while [ $i -lt 12 ] && grep -q waitting /proc/wlan0/SS_Result 2>/dev/null; do sleep 1; i=$((i+1)); done
+	list=$(awk -F': ' '
+		/HwAddr:/  {m=$2}
+		/Channel:/ {c=$2}
+		/SSID:/    {sub(/^[ \t]*SSID: /,""); s=$0; gsub(/\\/,"\\\\",s); gsub(/"/,"\\\"",s)}
+		/RSSI:/    {r=$2}
+		/====/     {if(m!=""){printf "%s{\"bssid\":\"%s\",\"channel\":%d,\"ssid\":\"%s\",\"rssi\":%d}", sep, m, c, s, r; sep=","; m=""}}
+	' /proc/wlan0/SS_Result 2>/dev/null)
+	out "{\"ok\":true,\"networks\":[${list}]}"
+	;;
+setpw)
+	[ "$REQUEST_METHOD" = POST ] || fail "POST required"
+	pw=$(param pw)
+	[ ${#pw} -ge 8 ] || fail "password must be at least 8 characters"
+	printf '%s\n%s\n' "$pw" "$pw" | passwd root >/dev/null 2>&1 || fail "passwd failed"
+	# protect the whole site with the system root password from now on
+	[ -f /etc/httpd.conf ] || { echo '/:root:$p$root' > /etc/httpd.conf; uci set uhttpd.main.config=/etc/httpd.conf; uci commit uhttpd; ( sleep 1; /etc/init.d/uhttpd restart ) >/dev/null 2>&1 & }
+	out '{"ok":true}'
+	;;
+setap)
+	[ "$REQUEST_METHOD" = POST ] || fail "POST required"
+	ssid=$(param ssid); key=$(param key)
+	[ -n "$ssid" ] && [ ${#ssid} -le 32 ] || fail "network name must be 1-32 characters"
+	[ ${#key} -ge 8 ] && [ ${#key} -le 63 ] || fail "Wi-Fi password must be 8-63 characters"
+	uci set wireless.ap0.ssid="$ssid"; uci set wireless.ap0.key="$key"; uci set wireless.ap0.encryption=psk2
+	uci commit wireless; apply_bg
+	out '{"ok":true}'
+	;;
+setuplink)
+	[ "$REQUEST_METHOD" = POST ] || fail "POST required"
+	ssid=$(param ssid); key=$(param key); bssid=$(param bssid)
+	[ -n "$ssid" ] && [ ${#ssid} -le 32 ] || fail "upstream network name must be 1-32 characters"
+	if [ -n "$key" ]; then
+		[ ${#key} -ge 8 ] && [ ${#key} -le 63 ] || fail "upstream password must be 8-63 characters"
+		uci set wireless.uplink.encryption=psk2; uci set wireless.uplink.key="$key"
+	else
+		uci set wireless.uplink.encryption=none; uci -q delete wireless.uplink.key
+	fi
+	uci set wireless.uplink.ssid="$ssid"
+	if [ -n "$bssid" ]; then uci set wireless.uplink.bssid="$bssid"; else uci -q delete wireless.uplink.bssid; fi
+	uci set wireless.uplink.disabled=0
+	# repeater: LAN takes its address from the upstream router, 192.168.1.1 stays for management
+	uci set network.lan.proto=dhcp; uci -q delete network.lan.ipaddr; uci -q delete network.lan.netmask
+	uci set network.mgmt=interface; uci set network.mgmt.device=br-lan; uci set network.mgmt.proto=static
+	uci set network.mgmt.ipaddr=192.168.1.1/24
+	uci set dhcp.lan.ignore=1
+	uci commit wireless; uci commit network; uci commit dhcp; apply_bg
+	out '{"ok":true}'
+	;;
+clearuplink)
+	[ "$REQUEST_METHOD" = POST ] || fail "POST required"
+	uci set wireless.uplink.disabled=1
+	uci set network.lan.proto=static; uci set network.lan.ipaddr=192.168.1.1; uci set network.lan.netmask=255.255.255.0
+	uci -q delete network.mgmt
+	uci -q delete dhcp.lan.ignore
+	uci commit wireless; uci commit network; uci commit dhcp; apply_bg
+	out '{"ok":true}'
+	;;
+setip)
+	# fixed address on the home network (repeater mode); empty = take it from DHCP
+	[ "$REQUEST_METHOD" = POST ] || fail "POST required"
+	[ "$(mode)" = repeater ] || fail "only available in repeater mode"
+	ip=$(param ip)
+	if [ -z "$ip" ]; then
+		uci set network.lan.proto=dhcp
+		for o in ipaddr netmask gateway dns; do uci -q delete network.lan.$o; done
+	else
+		echo "$ip" | grep -qE '^([0-9]{1,3}\.){3}[0-9]{1,3}$' || fail "not an IPv4 address"
+		gw=$(ip -4 route show default | awk '{print $3; exit}')
+		[ -n "$gw" ] || fail "no upstream gateway yet - connect first"
+		[ "${ip%.*}" = "${gw%.*}" ] || fail "address must be in the same network as $gw"
+		[ "$ip" != "$gw" ] || fail "that is the main router's address"
+		uci set network.lan.proto=static; uci set network.lan.ipaddr="$ip"; uci set network.lan.netmask=255.255.255.0
+		uci set network.lan.gateway="$gw"; uci -q delete network.lan.dns; uci add_list network.lan.dns="$gw"
+	fi
+	uci commit network
+	( sleep 1; /etc/init.d/network reload ) >/dev/null 2>&1 &
+	out "{\"ok\":true,\"ip\":$(js "$ip")}"
+	;;
+reboot)
+	[ "$REQUEST_METHOD" = POST ] || fail "POST required"
+	( sleep 1; reboot ) >/dev/null 2>&1 &
+	out '{"ok":true}'
+	;;
+factory)
+	[ "$REQUEST_METHOD" = POST ] || fail "POST required"
+	( sleep 1; firstboot -y; reboot ) >/dev/null 2>&1 &
+	out '{"ok":true}'
+	;;
+*)
+	fail "unknown action"
+	;;
+esac
