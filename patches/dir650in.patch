diff -ruN a/target/linux/rtl819x/dts/rtl8197f_dlink_dir-650in.dts b/target/linux/rtl819x/dts/rtl8197f_dlink_dir-650in.dts
--- a/target/linux/rtl819x/dts/rtl8197f_dlink_dir-650in.dts
+++ b/target/linux/rtl819x/dts/rtl8197f_dlink_dir-650in.dts
@@ -0,0 +1,111 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * D-Link DIR-650IN (ODM board JCG JIR-N700R V1.0)
+ *
+ *   SoC   RTL8197FH-VG, MIPS 24Kc @ 1 GHz
+ *   RAM   64 MB DDR2 (in package)
+ *   Flash 4 MB SPI NOR, EON EN25QH32B
+ *   LAN   internal switch ports 0-3, WAN = port 4, all 10/100 internal PHYs
+ *   WLAN  built-in 2.4 GHz 2T2R only
+ *   UART  38400 8N1, header next to the flash (VCC GND TX RX)
+ *
+ * Stock flash map (from /proc/mtd and the image itself):
+ *   0x000000 bootloader, 0x020000 hwconfig ("H6", MAC at 0x20007),
+ *   0x02a000 compressed settings, 0x030000 kernel (cr6c),
+ *   0x210000 squashfs rootfs, 0x3e0000 jffs2.
+ *
+ * Flash layout mirrors stock (verified against the stock image): kernel at
+ * 0x30000, rootfs at 0x210000 - the bootloader checks both. boot stays read-only.
+ */
+/dts-v1/;
+
+#include "RTL8197FVG.dtsi"
+
+#include <dt-bindings/gpio/gpio.h>
+
+/ {
+	compatible = "dlink,dir-650in", "realtek,rtl8197f-soc";
+	model = "D-Link DIR-650IN";
+
+	memory {
+		device_type = "memory";
+		reg = <0x0 0x4000000>;
+	};
+
+	chosen {
+		bootargs = "console=ttyS0,38400";
+	};
+};
+
+&gpio0 {
+	status = "okay";
+};
+
+&gpio1 {
+	status = "okay";
+};
+
+&ethernet {
+	status = "okay";
+
+	/* jacks sit on the SoC's own PHYs: no RGMII, no external switch */
+	realtek,internal-phy;
+
+	nvmem-cells = <&mac_factory>;
+	nvmem-cell-names = "mac-address";
+};
+
+&spi0 {
+	status = "okay";
+
+	flash@0 {
+		#address-cells = <1>;
+		#size-cells = <1>;
+		compatible = "jedec,spi-nor";
+		reg = <0>;
+		spi-max-frequency = <15000000>;
+
+		partitions {
+			compatible = "fixed-partitions";
+			#address-cells = <1>;
+			#size-cells = <1>;
+
+			partition@0 {
+				label = "boot";
+				reg = <0x000000 0x030000>;
+				read-only;
+
+				#address-cells = <1>;
+				#size-cells = <1>;
+
+				nvmem-layout {
+					compatible = "fixed-layout";
+					#address-cells = <1>;
+					#size-cells = <1>;
+
+					mac_factory: macaddr@20007 {
+						compatible = "mac-base";
+						reg = <0x20007 0x6>;
+					};
+				};
+			};
+
+			partition@30000 {
+				label = "kernel";
+				reg = <0x030000 0x1e0000>;
+			};
+
+			/* squashfs + bootloader checksum; the kernel splits off rootfs_data after it */
+			partition@210000 {
+				label = "rootfs";
+				reg = <0x210000 0x1f0000>;
+			};
+
+			/* kernel + rootfs together, for sysupgrade / mtd write */
+			firmware@30000 {
+				label = "firmware";
+				reg = <0x030000 0x3d0000>;
+			};
+		};
+	};
+};
