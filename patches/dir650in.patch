@@ -18,3 +18,23 @@
   CVIMG_CUSTOM_SIGNATURE := KE32
 endef
 TARGET_DEVICES += electra_rx23302
+
+# D-Link DIR-650IN (JCG JIR-N700R V1.0), RTL8197FH-VG, 4 MB flash.
+# Same bootloader as the RX23302 ("RTL8197F-VG boot code v3.4.14b"):
+# stock kernel header cr6c, start 0x80a00000, burn offset 0x30000.
+# Bring-up profile: RAM (initramfs) boot only — no flash images yet.
+define Device/dlink_dir-650in
+  CMDLINE := console=ttyS0,38400 rtl8192cd.pcie5g=0
+  SOC := rtl8197f
+  DEVICE_VENDOR := D-Link
+  DEVICE_MODEL := DIR-650IN
+  IMAGE_SIZE := 3776k
+  CVIMG_KERNEL_BURN_ADDR := 0x30000
+  CVIMG_LOADER_START_ADDR := 0x80A00000
+  CVIMG_CUSTOM_SIGNATURE := cr6c
+  IMAGES := kernel.bin rootfs.bin full.bin
+  IMAGE/kernel.bin := append-kernel
+  IMAGE/rootfs.bin := append-rootfs
+  IMAGE/full.bin := dir650in-full
+endef
+TARGET_DEVICES += dlink_dir-650in
