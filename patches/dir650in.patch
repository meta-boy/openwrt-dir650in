+<div id="msg"></div>
+<script>
+const $=id=>document.getElementById(id);
+let selBssid="";
+function toast(t,ms){const m=$('msg');m.textContent=t;m.style.display='block';clearTimeout(m._t);m._t=setTimeout(()=>m.style.display='none',ms||3500)}
+async function api(a,data){
+  const opt=data?{method:'POST',headers:{'Content-Type':'application/x-dir650in-form'},
+    body:new URLSearchParams(Object.assign({a},data)).toString()}:{};
+  const r=await fetch('/cgi-bin/api'+(data?'':'?a='+a),opt);
+  const j=await r.json();
+  if(!j.ok)throw new Error(j.error||'failed');
+  return j;
+}
+function sig(r){return r>=60?'▂▄▆█':r>=45?'▂▄▆':r>=30?'▂▄':'▂'}
+function dur(s){const d=Math.floor(s/86400),h=Math.floor(s%86400/3600),m=Math.floor(s%3600/60);return(d?d+'d ':'')+h+'h '+m+'m'}
+async function refresh(){
+  let s;
+  try{s=await api('status')}catch(e){return}
+  $('pwcard').classList.toggle('hide',s.pw);
+  $('app').classList.toggle('hide',!s.pw);
+  const md=$('mode');md.textContent=s.mode==='repeater'?'Repeater':'Setup';md.className='pill '+(s.mode==='repeater'?'ok':'warn');
+  if(s.mode==='repeater'){
+    $('s_up').innerHTML=s.up_connected?'<span class="ok">Connected</span> to '+esc(s.up_ssid):'<span class="bad">Not connected</span> ('+esc(s.up_ssid)+')';
+    $('s_sig').textContent=s.up_connected?sig(s.up_rssi)+'  '+s.up_rssi+'%':'—';
+  }else{$('s_up').textContent='Not configured';$('s_sig').textContent='—'}
+  $('s_ch').textContent=s.channel||'—';
+  $('s_ip').textContent=s.ips.replace(/,/g,', ')||'—';
+  $('s_cl').textContent=s.clients.length;
+  $('s_ut').textContent=dur(s.uptime);
+  $('s_mem').textContent=Math.round(s.mem_avail/1024)+' / '+Math.round(s.mem_total/1024)+' MB';
+  if(!$('a_ssid').value&&document.activeElement!==$('a_ssid'))$('a_ssid').value=s.ap_ssid;
+  if(!$('u_ssid').value&&document.activeElement!==$('u_ssid'))$('u_ssid').value=s.up_ssid;
+}
+function esc(t){return String(t).replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]))}
+async function scan(){
+  const b=$('b_scan');b.disabled=true;b.textContent='Scanning…';
+  try{
+    const r=await api('scan');const n=r.networks.filter(x=>x.ssid).sort((a,b)=>b.rssi-a.rssi);
+    $('nets').innerHTML=n.length?n.map(x=>`<div class="net" data-s="${esc(x.ssid)}" data-b="${x.bssid}"><span>${esc(x.ssid)}</span><span class="bars">${sig(x.rssi)} ch${x.channel}</span></div>`).join(''):'<span class="k">No networks found.</span>';
+    document.querySelectorAll('.net').forEach(el=>el.onclick=()=>{document.querySelectorAll('.net').forEach(e=>e.classList.remove('sel'));el.classList.add('sel');$('u_ssid').value=el.dataset.s;selBssid='';$('u_key').focus()});
+  }catch(e){toast(e.message)}
+  b.disabled=false;b.textContent='Scan';
+}
+async function run(a,d,okmsg){try{await api(a,d);toast(okmsg,6000)}catch(e){toast(e.message)}}
+function uplink(){run('setuplink',{ssid:$('u_ssid').value,key:$('u_key').value,bssid:selBssid},'Connecting… the router keeps 192.168.1.1 for this page.')}
+function clearup(){if(confirm('Stop repeating and go back to setup mode?'))run('clearuplink',{},'Back to setup mode.')}
+function setap(){run('setap',{ssid:$('a_ssid').value,key:$('a_key').value},'Saved. Reconnect to the new Wi-Fi if you changed it.')}
+async function setpw(){if($('pw1').value!==$('pw2').value)return toast('Passwords do not match');await run('setpw',{pw:$('pw1').value},'Password set. Log in as root.');setTimeout(()=>location.reload(),2500)}
+function chpw(){run('setpw',{pw:$('n_pw').value},'Password changed.')}
+function setip(){const v=$('f_ip').value.trim();run('setip',{ip:v},v?'Saved. Open http://'+v+' (or extender.local).':'Address is automatic again.')}
+function act(a,t){run(a,{},t)}
+refresh();setInterval(refresh,5000);
+</script>
+</body>
