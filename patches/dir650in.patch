--- a/files/www/index.html
+++ b/files/www/index.html
@@ -0,0 +1,154 @@
+<!doctype html>
+<html lang="en">
+<head>
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width,initial-scale=1">
+<title>Extender</title>
+<style>
+:root{--bg:#f4f5f7;--card:#fff;--fg:#1c1f23;--mut:#6b7280;--line:#e4e6ea;--acc:#2563eb;--ok:#15803d;--bad:#b91c1c;--warn:#b45309}
+@media (prefers-color-scheme:dark){:root{--bg:#111418;--card:#1a1e24;--fg:#e8eaed;--mut:#9aa0a6;--line:#2a2f37;--acc:#60a5fa;--ok:#4ade80;--bad:#f87171;--warn:#fbbf24}}
+*{box-sizing:border-box}
+body{margin:0;background:var(--bg);color:var(--fg);font:15px/1.45 system-ui,-apple-system,Segoe UI,Roboto,sans-serif}
+header{padding:16px;display:flex;align-items:center;justify-content:space-between;max-width:720px;margin:auto}
+h1{font-size:18px;margin:0}
+main{max-width:720px;margin:auto;padding:0 16px 32px}
+.card{background:var(--card);border:1px solid var(--line);border-radius:12px;padding:16px;margin-bottom:14px}
+h2{font-size:15px;margin:0 0 12px}
+.row{display:flex;justify-content:space-between;gap:12px;padding:6px 0;border-top:1px solid var(--line)}
+.row:first-of-type{border-top:0}
+.k{color:var(--mut)}
+.v{text-align:right;word-break:break-all}
+label{display:block;font-size:13px;color:var(--mut);margin:10px 0 4px}
+input{width:100%;padding:10px 12px;border:1px solid var(--line);border-radius:8px;background:var(--bg);color:var(--fg);font:inherit}
+button{font:inherit;padding:10px 14px;border-radius:8px;border:1px solid var(--line);background:var(--card);color:var(--fg);cursor:pointer}
+button.p{background:var(--acc);border-color:var(--acc);color:#fff}
+button.d{color:var(--bad)}
+button:disabled{opacity:.5;cursor:default}
+.btns{display:flex;flex-wrap:wrap;gap:8px;margin-top:14px}
+.pill{display:inline-block;padding:2px 10px;border-radius:999px;font-size:13px;border:1px solid currentColor}
+.ok{color:var(--ok)}.bad{color:var(--bad)}.warn{color:var(--warn)}
+.net{display:flex;justify-content:space-between;align-items:center;gap:8px;padding:10px 0;border-top:1px solid var(--line);cursor:pointer}
+.net:first-child{border-top:0}
+.net.sel{color:var(--acc)}
+.bars{font-variant-numeric:tabular-nums;color:var(--mut);white-space:nowrap}
+#msg{position:fixed;left:50%;bottom:20px;transform:translateX(-50%);background:var(--fg);color:var(--bg);padding:10px 16px;border-radius:8px;display:none;max-width:90%}
+.hide{display:none}
+</style>
+</head>
+<body>
+<header><h1>Extender</h1><span id="mode" class="pill"></span></header>
+<main>
+
+<section id="pwcard" class="card hide">
+  <h2>Set an admin password</h2>
+  <p class="k">The router has no password yet. Choose one (8+ characters). You'll log in with user <b>root</b> and this password.</p>
+  <label for="pw1">New password</label><input id="pw1" type="password" autocomplete="new-password">
+  <label for="pw2">Repeat password</label><input id="pw2" type="password" autocomplete="new-password">
+  <div class="btns"><button class="p" onclick="setpw()">Save password</button></div>
