 	rtl_sw_w(RTL_PCRP(2), 0x487F0039);
 	rtl_sw_w(RTL_PCRP(3), 0x4C7F0039);
 	rtl_sw_w(RTL_PCRP(4), 0x507F0039);
+	}
 
 	/*
 	 * Внутренние порты, включая восьмой - порт процессора. Их я в первый
@@ -2020,6 +2031,14 @@
 
 	spin_lock_init(&eth->lock);
 
+	rtl819x_internal_phy = of_property_read_bool(np, "realtek,internal-phy");
+	if (rtl819x_internal_phy) {
+		/* flat bring-up: LAN frames to all jacks 0-4, WAN (eth0.8) to port 4 */
+		rtl819x_gnezda_lan = 0x1F;
+		rtl819x_gnezda_wan = 0x10;
+		dev_info(&pdev->dev, "internal-PHY mode: jacks on ports 0-4\n");
+	}
+
 	eth->base = devm_platform_ioremap_resource(pdev, 0);
 	if (IS_ERR(eth->base))
 		return PTR_ERR(eth->base);
